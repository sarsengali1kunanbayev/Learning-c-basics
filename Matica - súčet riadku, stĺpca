#include <stdio.h>

#define MAX 20

void nacitajMaticu(int A[MAX][MAX], int m, int n) {
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &A[i][j]);
        }
    }
}

int sucetRiadku(int A[MAX][MAX], int n, int k) {
    int suma = 0;
    for (int j = 0; j < n; j++) {
        suma += A[k][j];
    }
    return suma;
}

int sucetStlpca(int A[MAX][MAX], int m, int k) {
    int suma = 0;
    for (int i = 0; i < m; i++) {
        suma += A[i][k];
    }
    return suma;
}

int main() {
    int m, n;
    int A[MAX][MAX];
    int i, j;

    scanf("%d%d", &m, &n);
    nacitajMaticu(A, m, n);
    scanf("%d%d", &i, &j);

    printf("%d %d\n", sucetRiadku(A, n, i), sucetStlpca(A, m, j));

    return 0;
}
